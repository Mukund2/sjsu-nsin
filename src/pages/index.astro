---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsoleFooter from "../components/layout/ConsoleFooter.astro";
import EarthDive from "../components/home/EarthDive.astro";
import ValleyTimeline from "../components/home/ValleyTimeline.astro";
import { domains } from "../data/domains";

const bySlug = Object.fromEntries(domains.map((d) => [d.slug, d]));

// the traverse: one continuous scene, seabed to orbit (tiles top->bottom in DOM)
const tiles = [
  { src: "/images/domains/orbit-limb.jpg", alt: "Earth's limb at the day-night terminator from low orbit" },
  { src: "/images/domains/cloud-deck.jpg", alt: "A golden cloud deck at cruise altitude" },
  { src: "/images/domains/sea-surface.jpg", alt: "Open Pacific swells at golden hour" },
  { src: "/images/domains/water-column.jpg", alt: "Light shafts falling through deep water" },
  { src: "/images/domains/seabed-cable.jpg", alt: "An undersea fiber-optic cable crossing the seabed" },
];

const caps = [
  { name: bySlug.space.name, tagline: bySlug.space.tagline, slug: "space" },
  { name: bySlug.air.name, tagline: bySlug.air.tagline, slug: "air" },
  { name: bySlug.sea.name, tagline: bySlug.sea.tagline, slug: "sea" },
  {
    name: "The seabed",
    tagline: "Almost all intercontinental data crosses the ocean floor on cables like this one — nearly undefended.",
    slug: null,
  },
  {
    name: bySlug.cyber.name,
    tagline: "Cyber has no altitude. It’s the layer under all of the others.",
    slug: "cyber",
  },
];




---

<BaseLayout theme="console">
  <EarthDive />

  <ValleyTimeline />



  <section class="scheme-paper px-5 sm:px-10 pb-20">
    <div class="max-w-[1500px] mx-auto">
      <h2 class="t-h2 max-w-[16ch]" data-reveal>Pick your altitude.</h2>
      <p class="t-body mt-5 text-ink/60">
        The club works in four domains. You start in orbit — scroll to descend
        through all of them, down to the cables on the seabed.
      </p>
    </div>
  </section>

  <!-- the traverse — one unbroken climb from the seabed to orbit -->
  <section id="altitude" class="scheme-ink relative">
    <div id="alt-pin" class="relative h-screen overflow-hidden">
      <div id="alt-strip" class="absolute inset-x-0 top-0 will-change-transform" style="height: 500vh;">
        {tiles.map((t) => (
          <img src={t.src} alt={t.alt} class="block w-full h-screen object-cover" loading="eager" decoding="async" />
        ))}
      </div>

      <figure id="alt-cyber" class="absolute inset-0 m-0" style="opacity: 0;">
        <img
          src="/images/domains/cyber-2.jpg"
          alt="Blue-lit racks inside a supercomputing facility"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </figure>

      <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-ink/25 pointer-events-none"></div>

      {caps.map((c, i) => (
        <div class="alt-cap absolute inset-x-0 bottom-0" style={i === 0 ? "" : "opacity: 0; visibility: hidden;"}>
          <div class="max-w-[1500px] mx-auto px-5 sm:px-10 pb-16 sm:pb-20">
            <h3 class="t-h1 text-paper">{c.name}</h3>
            <p class="t-lede mt-4 text-paper/75 max-w-[38ch]">{c.tagline}</p>
            {c.slug && (
              <a
                href={`/domains/${c.slug}`}
                class="press arrow-link mt-7 inline-block w-fit bg-paper text-ink px-7 py-3.5 text-[15px] font-medium"
              >
                Explore {c.name} <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        </div>
      ))}

      <!-- the altimeter: a live instrument, not decoration -->
      <div class="absolute right-6 sm:right-10 top-1/2 -translate-y-1/2 h-[58vh] hidden sm:flex items-stretch gap-5 pointer-events-none">
        <div class="flex flex-col justify-between items-end text-right">
          <p id="alt-readout" class="t-h3 text-paper" style="font-variant-numeric: tabular-nums;">408 km</p>
          <p class="t-caption text-paper/45">altitude</p>
        </div>
        <div class="relative w-px bg-paper/25">
          <div
            id="alt-marker"
            class="absolute right-0 w-5 h-px"
            style="background-color: var(--color-gold); top: 0%;"
          ></div>
        </div>
      </div>
    </div>
  </section>

  <section class="scheme-ink relative overflow-hidden">
    <img
      src="/images/domains/space-3.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-80"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-ink/55"></div>
    <div class="relative z-10 py-32 sm:py-44 px-5 sm:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="t-h1 text-paper" data-reveal>Join the first cohort.</h2>
        <p class="t-lede text-paper/70 mt-7 mb-12 max-w-xl mx-auto">
          Cohort 01 starts fall 2026: weekly build nights, the speaker
          series, and the first government project teams. No experience
          required — every major has a seat.
        </p>
        <a
          href="https://forms.gle/9MLweCMRaaTkrEkGA"
          target="_blank"
          rel="noopener noreferrer"
          class="press inline-block bg-paper text-ink px-9 py-3.5 text-[15px] font-medium"
        >
          Apply to the first cohort
        </a>
      </div>
    </div>
  </section>

  <ConsoleFooter />
</BaseLayout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.registerPlugin(ScrollTrigger);

// ── the traverse: one continuous pan, seabed to orbit ──
    const strip = document.getElementById("alt-strip");
    const altCaps = gsap.utils.toArray<HTMLElement>(".alt-cap");
    const cyberFig = document.getElementById("alt-cyber");
    const readout = document.getElementById("alt-readout");
    const marker = document.getElementById("alt-marker");

    gsap.set(altCaps, { autoAlpha: 0 });
    gsap.set(altCaps[0], { autoAlpha: 1 });

    const PAN = 4; // four tile transitions
    const HOLD = 0.6; // rest at orbit
    const CYB = 0.45; // cyber takes over
    const TAIL2 = 0.5;
    const total = PAN + HOLD + CYB + TAIL2;

    const fmt = (m: number) => {
      if (m >= 20000) return `${Math.round(m / 1000)} km`;
      const v = Math.round(m / 10) * 10;
      return `${v < 0 ? "−" : ""}${Math.abs(v).toLocaleString("en-US")} m`;
    };
    const altitudeAt = (u: number) => {
      if (u < 1) return 408000 - (408000 - 11000) * u;
      if (u < 2) return 11000 * (2 - u);
      if (u < 4) return -2000 * (u - 2);
      if (u < PAN + HOLD) return -4000;
      return null; // cyber, the layer underneath
    };

    const atl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: "#alt-pin",
        start: "top top",
        end: "+=" + (PAN + 1.5) * 110 + "%",
        pin: true,
        scrub: 0.4,
        anticipatePin: 1,
        onUpdate(self) {
          if (!readout || !marker) return;
          const u = self.progress * total;
          const alt = altitudeAt(u);
          if (alt === null) {
            readout.textContent = "no altitude";
            marker.style.top = "100%";
          } else {
            readout.textContent = fmt(alt);
            const descent = Math.min(u / PAN, 1);
            marker.style.top = `${descent * 100}%`;
          }
        },
      },
    });

    if (strip) {
      atl.fromTo(strip, { yPercent: 0 }, { yPercent: -80, duration: PAN }, 0);
    }

    // caption windows along the climb: [in, out]
    const windows = [
      [0, 1.05],
      [1.55, 2.5],
      [2.55, 3.5],
      [3.55, PAN + HOLD - 0.05],
      [PAN + HOLD + 0.2, Infinity],
    ];
    altCaps.forEach((cap, i) => {
      const [tin, tout] = windows[i];
      if (i > 0) {
        atl.fromTo(cap, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.35 }, tin);
      }
      if (tout !== Infinity) {
        atl.to(cap, { autoAlpha: 0, y: -20, duration: 0.25 }, tout);
      }
    });

    if (cyberFig) {
      atl.to(cyberFig, { autoAlpha: 1, duration: CYB }, PAN + HOLD);
    }
    atl.to({}, { duration: TAIL2 }, total - TAIL2);
  }
</script>
