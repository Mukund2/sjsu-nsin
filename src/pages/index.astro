---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsoleFooter from "../components/layout/ConsoleFooter.astro";
import DomainConsole from "../components/home/DomainConsole";
import ConsoleSections from "../components/home/ConsoleSections";
import { domains } from "../data/domains";

const domainProps = domains.map(({ slug, name, accent, accentSoft, tagline, hero }) => ({
  slug,
  name,
  accent,
  accentSoft,
  tagline,
  hero,
}));
---

<BaseLayout theme="console">
  <DomainConsole client:load domains={domainProps} />
  <ConsoleSections client:load />
  <ConsoleFooter />
</BaseLayout>
