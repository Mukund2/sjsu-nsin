---
import BaseLayout from "../layouts/BaseLayout.astro";

// The one action on this page. Set `href` to the live application form.
const primary = {
  label: "Apply — Defense Innovation Program",
  note: "Fall 2026 cohort",
  href: "https://docs.google.com/forms/d/e/1FAIpQLSd_pP7M1mWnHXTT7HBJeexOmu2rHFrUXGHWxWoQH_dZWDDHTg/viewform",
};
---

<BaseLayout
  title="Links — SJSU NSIN"
  description="Apply to the Defense Innovation Program at National Security Innovation Network SJSU."
>
  <section class="py-20 sm:py-28 px-5">
    <div class="max-w-xl mx-auto">
      <header class="text-center">
        <img
          src="/logo.svg"
          alt=""
          width="44"
          height="30"
          class="mx-auto mb-7"
          aria-hidden="true"
        />
        <h1 class="text-3xl sm:text-4xl font-display text-near-black leading-tight">
          National Security Innovation Network
        </h1>
        <p
          class="mt-3 text-[13px] font-medium uppercase tracking-[0.15em] text-mid-gray"
        >
          San José State University
        </p>
      </header>

      <a
        href={primary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-12 block bg-near-black text-white text-center px-6 py-5 hover:bg-dark-gray transition-colors"
      >
        <span class="block text-[13px] font-medium uppercase tracking-[0.15em]">
          {primary.label}
        </span>
        <span class="block mt-1.5 text-sm text-white/60">{primary.note}</span>
      </a>
    </div>
  </section>
</BaseLayout>
