---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConsoleFooter from "../../components/layout/ConsoleFooter.astro";
import { domains, nextDomain } from "../../data/domains";

export function getStaticPaths() {
  return domains.map((domain) => ({
    params: { slug: domain.slug },
    props: { domain },
  }));
}

const { domain } = Astro.props;
const next = nextDomain(domain.slug);

const APPLY_URL = "https://forms.gle/9MLweCMRaaTkrEkGA";
---

<BaseLayout title={`${domain.name} — SJSU NSIN`} description={domain.tagline} theme="console">
  <div style={`--accent: ${domain.accent};`}>

    <!-- hero -->
    <section class="relative min-h-screen flex flex-col justify-end overflow-hidden">
      <img
        src={domain.hero}
        alt={domain.heroAlt}
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/25"></div>

      <div class="relative max-w-[1500px] mx-auto w-full px-5 sm:px-10 pb-24 pt-40">
        <h1 class="t-display text-paper" data-reveal>
          {domain.name}
        </h1>
        <p class="t-lede mt-6 text-paper/80 max-w-2xl">
          {domain.tagline}
        </p>
      </div>
    </section>

    <!-- intro + problems — warm paper scheme -->
    <section class="bg-paper">
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10 pt-24 pb-20">
        <p class="t-lede text-ink max-w-[52rem]">
          {domain.intro}
        </p>
      </div>
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10 pb-24">
        <h2 class="t-h2 text-ink mb-12">
          What&rsquo;s actually broken
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {domain.problems.map((problem) => (
            <div class="border-t border-ink/20 pt-6">
              <h3 class="t-h3 text-ink mb-3">{problem.title}</h3>
              <p class="text-[15px] text-ink/65 leading-relaxed">{problem.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- what you build — the page's big-breath section -->
    <section class="py-32 sm:py-44">
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10">
        <h2 class="t-h2 text-paper mb-12" data-reveal>
          What you&rsquo;d build here
        </h2>
        <div class="flex flex-col gap-24">
          {domain.builds.map((build, i) => (
            <div
              class:list={[
                "flex flex-col gap-8 md:items-end md:justify-between",
                i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
              ]}
            >
              <img
                src={build.image}
                alt={build.title}
                class="w-full md:w-[62%] aspect-[3/2] object-cover"
              />
              <div class="md:w-[34%]">
                <h3 class="t-h3 text-paper mb-5">{build.title}</h3>
                <p class="text-paper/60 leading-relaxed mb-8">{build.desc}</p>
                <a
                  href={APPLY_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="arrow-link link t-caption text-paper"
                >
                  Work on this <span class="arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- industry -->
    <section class="py-24 border-t border-paper/10">
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10">
        <h2 class="t-h2 text-paper mb-12" data-reveal>
          Who works on this
        </h2>
        <p class="text-paper/60 leading-relaxed max-w-2xl mb-14">{domain.companiesNote}</p>
        <p class="leading-tight">
          {domain.companies.map((company, i) => (
            <>
              {i > 0 && <span class="mx-3 sm:mx-5 align-middle text-2xl sm:text-3xl font-display" style={`color: ${domain.accent};`}>/</span>}
              <a
                href={company.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link text-2xl sm:text-4xl font-display text-paper/40 hover:text-paper"
              >
                {company.name}
              </a>
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- next domain -->
    <a
      href={`/domains/${next.slug}`}
      class="next-domain-band arrow-link block border-y border-paper/10 transition-colors duration-300 hover:bg-paper/5"
      style={`--next-accent: ${next.accent};`}
    >
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10 py-16 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-6">
        <span class="text-[14px] text-paper/50">Next domain</span>
        <span class="next-domain-name t-h1 text-paper transition-colors duration-300">
          {next.name} <span class="arrow inline-block" aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>

    <!-- cohort CTA -->
    <section class="bg-paper py-28">
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10 text-center">
        <h2 class="t-h1 text-ink mb-6">
          Join the first cohort.
        </h2>
        <p class="text-ink/60 mb-12 max-w-xl mx-auto">
          Applications open fall 2026. No experience required &mdash; whatever you
          study, there’s a seat.
        </p>
        <a
          href={APPLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="press inline-block bg-ink text-paper px-9 py-3.5 text-[15px] font-medium hover:bg-ink-deep transition-colors"
        >
          Apply to the first cohort
        </a>
      </div>
    </section>

    <!-- closing claim -->
    <section class="py-24">
      <div class="max-w-[1500px] mx-auto px-5 sm:px-10">
        <p class="t-h1 text-paper" data-reveal>
          {domain.closing}
        </p>
      </div>
    </section>

    <ConsoleFooter />
  </div>
</BaseLayout>

<style>
  .next-domain-band:hover .next-domain-name {
    color: var(--next-accent);
  }
</style>
