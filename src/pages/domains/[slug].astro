---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConsoleFooter from "../../components/layout/ConsoleFooter.astro";
import { domains, nextDomain } from "../../data/domains";

export function getStaticPaths() {
  return domains.map((domain) => ({
    params: { slug: domain.slug },
    props: { domain },
  }));
}

const { domain } = Astro.props;
const next = nextDomain(domain.slug);

const APPLY_URL = "https://forms.gle/9MLweCMRaaTkrEkGA";
---

<BaseLayout title={`${domain.name} — SJSU NSIN`} description={domain.tagline} theme="console">
  <div style={`--accent: ${domain.accent};`}>

    <!-- hero -->
    <section class="relative min-h-screen flex flex-col justify-end overflow-hidden">
      <img
        src={domain.hero}
        alt={`${domain.name} domain`}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/25"></div>

      <div class="relative max-w-7xl mx-auto w-full px-6 pb-24 pt-40">
        <h1 class="t-display text-paper">
          {domain.name}
        </h1>
        <p class="t-lede mt-6 text-paper/80 max-w-2xl">
          {domain.tagline}
        </p>
      </div>
    </section>

    <!-- intro + problems — warm paper scheme -->
    <section class="bg-paper">
      <div class="max-w-4xl mx-auto px-6 pt-24 pb-20">
        <p class="t-h3 text-ink">
          {domain.intro}
        </p>
      </div>
      <div class="max-w-7xl mx-auto px-6 pb-24">
        <h2 class="t-h2 text-ink mb-14">
          What&rsquo;s actually broken
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {domain.problems.map((problem) => (
            <div class="border-t border-ink/20 pt-6">
              <h3 class="text-xl font-display font-normal text-ink mb-3">{problem.title}</h3>
              <p class="text-[15px] text-ink/65 leading-relaxed">{problem.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- what you build -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="t-h2 text-paper mb-16" data-reveal>
          What you&rsquo;d build here
        </h2>
        <div class="flex flex-col gap-24">
          {domain.builds.map((build, i) => (
            <div class="grid md:grid-cols-2 gap-10 items-center">
              <div class:list={[i % 2 === 1 && "md:order-2"]}>
                <img
                  src={build.image}
                  alt={build.title}
                  class="aspect-[4/3] w-full object-cover"
                />
              </div>
              <div class:list={[i % 2 === 1 && "md:order-1"]}>
                <h3 class="t-h3 text-paper mb-5">{build.title}</h3>
                <p class="text-paper/60 leading-relaxed mb-8">{build.desc}</p>
                <a
                  href={APPLY_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[14px] text-paper border-b border-paper/40 pb-1 hover:border-paper transition-colors"
                >
                  Work on this &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- industry -->
    <section class="py-24 border-t border-paper/10">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="t-h2 text-paper mb-6" data-reveal>
          Who works on this
        </h2>
        <p class="text-paper/60 leading-relaxed max-w-2xl mb-14">{domain.companiesNote}</p>
        <p class="leading-tight">
          {domain.companies.map((company, i) => (
            <>
              {i > 0 && <span class="mx-3 sm:mx-5 align-middle text-2xl sm:text-3xl font-display" style={`color: ${domain.accent};`}>/</span>}
              <span class="text-2xl sm:text-4xl font-display text-paper/40 hover:text-paper transition-colors">
                {company}
              </span>
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- next domain -->
    <a
      href={`/domains/${next.slug}`}
      class="next-domain-band block border-y border-paper/10 transition-colors duration-300"
      style={`--next-accent: ${next.accent}; --next-accent-soft: ${next.accentSoft};`}
    >
      <div class="max-w-7xl mx-auto px-6 py-16 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-6">
        <span class="text-[14px] text-paper/50">Next domain</span>
        <span class="next-domain-name t-h1 text-paper transition-colors duration-300">
          {next.name} &rarr;
        </span>
      </div>
    </a>

    <!-- cohort CTA -->
    <section class="bg-paper py-28">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="t-h1 text-ink mb-6">
          Join the first cohort.
        </h2>
        <p class="text-ink/60 mb-12 max-w-xl mx-auto">
          Applications open fall 2026. No experience required &mdash; whatever you
          study, there's a seat.
        </p>
        <a
          href={APPLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-ink text-paper px-9 py-3.5 text-[14px] font-medium hover:bg-ink-deep transition-colors"
        >
          Apply to Cohort 01
        </a>
      </div>
    </section>

    <!-- closing slogan -->
    <section class="py-24 px-6 overflow-hidden">
      <p class="font-display text-[10vw] leading-none tracking-[-0.03em] text-center text-balance" style={`color: ${domain.accent};`}>
        {domain.slogan}
      </p>
    </section>

    <ConsoleFooter />
  </div>
</BaseLayout>

<style>
  .next-domain-band:hover {
    background-color: var(--next-accent-soft);
  }
  .next-domain-band:hover .next-domain-name {
    color: var(--next-accent);
  }
</style>
