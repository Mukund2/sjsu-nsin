---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConsoleFooter from "../../components/layout/ConsoleFooter.astro";
import { domains, nextDomain } from "../../data/domains";

export function getStaticPaths() {
  return domains.map((domain) => ({
    params: { slug: domain.slug },
    props: { domain },
  }));
}

const { domain } = Astro.props;
const next = nextDomain(domain.slug);

const APPLY_URL = "https://forms.gle/9MLweCMRaaTkrEkGA";
---

<BaseLayout title={`${domain.name} — SJSU NSIN`} description={domain.tagline} theme="console">
  <div style={`--accent: ${domain.accent};`}>

    <!-- 1 / HERO -->
    <section class="relative min-h-screen flex flex-col justify-end overflow-hidden">
      <img
        src={domain.hero}
        alt={`${domain.name} domain`}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/30"></div>
      <div class="absolute inset-0" style={`background-color: ${domain.accentSoft};`}></div>

      <div class="relative max-w-7xl mx-auto w-full px-6 pb-24 pt-40">
        <p class="decal text-accent mb-6">
          [ {domain.designator} // OPERATIONAL DOMAIN {domain.index} / 04 ]
        </p>
        <h1 class="font-display font-normal uppercase text-white text-7xl sm:text-8xl md:text-9xl leading-none">
          {domain.name}
        </h1>
        <p class="mt-6 text-xl sm:text-2xl text-white/80 max-w-2xl">
          {domain.tagline}
        </p>
      </div>

      <p class="hidden md:block absolute bottom-8 right-8 decal text-white/30">
        [ FEED // {domain.slug.toUpperCase()}-CAM-01 ]
      </p>

      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-3 pb-6">
        <span class="decal text-white/30">SCROLL</span>
        <span class="block w-px h-10 bg-white/30"></span>
      </div>
    </section>

    <!-- 2 / INTRO STRIP -->
    <section class="py-24">
      <div class="max-w-4xl mx-auto px-6">
        <p class="decal text-accent mb-8">[ SITREP ]</p>
        <p class="text-2xl sm:text-3xl font-display text-white leading-snug">
          {domain.intro}
        </p>
      </div>
    </section>

    <!-- 3 / THE PROBLEM -->
    <section class="py-24 border-t border-white/10">
      <div class="max-w-7xl mx-auto px-6">
        <p class="decal text-accent mb-6">[ THE PROBLEM ]</p>
        <h2 class="font-display font-normal text-white text-4xl sm:text-5xl mb-16">
          What&rsquo;s actually broken.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {domain.problems.map((problem) => (
            <div class="border-t border-white/10 hover:border-accent transition-colors duration-300 pt-6">
              <p class="decal text-white/30 mb-4">{domain.designator}-P{problem.num}</p>
              <h3 class="text-xl font-display font-normal text-white mb-3">{problem.title}</h3>
              <p class="text-sm text-white/50 leading-relaxed">{problem.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 / WHAT YOU BUILD -->
    <section class="py-24 border-t border-white/10">
      <div class="max-w-7xl mx-auto px-6">
        <p class="decal text-accent mb-6">[ WHAT YOU BUILD ]</p>
        <h2 class="font-display font-normal text-white text-4xl sm:text-5xl mb-20">
          Your hands on real problems.
        </h2>
        <div class="flex flex-col gap-24">
          {domain.builds.map((build, i) => (
            <div class="grid md:grid-cols-2 gap-10 items-center">
              <div class:list={["group relative border border-white/10", i % 2 === 1 && "md:order-2"]}>
                <img
                  src={build.image}
                  alt={build.title}
                  class="mono-img aspect-[4/3] w-full object-cover"
                />
                <span class="decal text-white/80 absolute bottom-4 left-4 bg-black/60 px-3 py-1.5">
                  [ {build.tag} ]
                </span>
              </div>
              <div class:list={[i % 2 === 1 && "md:order-1"]}>
                <h3 class="text-3xl font-display font-normal text-white mb-5">{build.title}</h3>
                <p class="text-white/50 leading-relaxed mb-8">{build.desc}</p>
                <a
                  href={APPLY_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="decal text-accent border-b border-accent pb-1 inline-block"
                >
                  Discover &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5 / THE INDUSTRY -->
    <section class="py-24 border-t border-white/10">
      <div class="max-w-7xl mx-auto px-6">
        <p class="decal text-accent mb-6">[ THE INDUSTRY ]</p>
        <h2 class="font-display font-normal text-white text-4xl sm:text-5xl mb-6">
          Who works on this.
        </h2>
        <p class="text-white/50 leading-relaxed max-w-2xl mb-16">{domain.companiesNote}</p>
        <p class="leading-tight">
          {domain.companies.map((company, i) => (
            <>
              {i > 0 && <span class="decal text-accent mx-3 sm:mx-5 align-middle">/</span>}
              <span class="text-2xl sm:text-4xl font-display text-white/35 hover:text-white transition-colors">
                {company}
              </span>
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- 6 / NEXT DOMAIN -->
    <a
      href={`/domains/${next.slug}`}
      class="next-domain-band block border-y border-white/10 transition-colors duration-300"
      style={`--next-accent: ${next.accent}; --next-accent-soft: ${next.accentSoft};`}
    >
      <div class="max-w-7xl mx-auto px-6 py-16 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <span class="decal text-white/40">[ NEXT DOMAIN ]</span>
        <span class="next-domain-name font-display font-normal uppercase text-white text-5xl transition-colors duration-300">
          {next.name} &rarr;
        </span>
      </div>
    </a>

    <!-- 7 / COHORT CTA -->
    <section class="py-32">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="decal text-accent mb-8">[ COHORT-01 // APPLICATIONS OPEN &mdash; FALL 2026 ]</p>
        <h2 class="font-display font-normal text-white text-5xl sm:text-6xl mb-6">
          Join the first cohort.
        </h2>
        <p class="text-white/50 mb-12">No experience required. Conviction required.</p>
        <a
          href={APPLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-near-black px-10 py-3.5 uppercase tracking-[0.15em] text-[13px] hover:bg-accent transition-colors duration-300"
        >
          Apply Now
        </a>
      </div>
    </section>

    <!-- 8 / GIANT SLOGAN -->
    <section class="py-28 overflow-hidden">
      <p class="font-display text-accent text-[14vw] leading-none text-center whitespace-nowrap">
        {domain.slogan}
      </p>
    </section>

    <ConsoleFooter />
  </div>
</BaseLayout>

<style>
  .next-domain-band:hover {
    background-color: var(--next-accent-soft);
  }
  .next-domain-band:hover .next-domain-name {
    color: var(--next-accent);
  }
</style>
