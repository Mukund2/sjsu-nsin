---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsoleFooter from "../components/layout/ConsoleFooter.astro";

const APPLY_URL = "https://forms.gle/9MLweCMRaaTkrEkGA";

const channels = [
  {
    name: "Instagram",
    handle: "@sjsu_nsin",
    href: "https://www.instagram.com/sjsu_nsin/",
  },
  {
    name: "LinkedIn",
    handle: "SJSU NSIN",
    href: "https://www.linkedin.com/company/sjsu-nsin/",
  },
];
---

<BaseLayout
  title="Contact — SJSU NSIN"
  description="Reach NSIN at San José State — speaker suggestions, partnerships, or questions about joining the first cohort."
  theme="console"
>
  <!-- opening — the channels are the page -->
  <section class="scheme-ink pt-44 sm:pt-56 pb-24 sm:pb-32 px-5 sm:px-10">
    <div class="max-w-[1500px] mx-auto">
      <h1 class="t-display text-paper max-w-[12ch]" data-reveal>
        Get in touch.
      </h1>
      <p class="t-lede text-paper/70 max-w-[46ch] mt-8">
        Curious about what we’re building, have a speaker to suggest, or want
        to partner with the club? We’re easiest to reach on the channels
        below.
      </p>

      <div class="mt-20 border-t border-paper/15">
        {channels.map((channel) => (
          <a
            href={channel.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 sm:gap-8 border-b border-paper/15 py-9"
          >
            <span class="t-h2 text-paper/60 group-hover:text-paper transition-colors duration-300">
              {channel.name}
            </span>
            <span class="t-caption text-paper/45 group-hover:text-paper/80 transition-colors duration-300">
              {channel.handle} &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ready to join -->
  <div class="seam-to-paper"></div>
  <section class="scheme-paper pt-24 sm:pt-32 pb-24 sm:pb-32 px-5 sm:px-10">
    <div class="max-w-[1500px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <h2 class="t-h2 max-w-[14ch]" data-reveal>Ready to join?</h2>
        <p class="t-body mt-6 text-ink/65">
          Applications for the first cohort open fall 2026. The membership
          form takes about five minutes, and no experience is required —
          whatever you study, there’s a seat.
        </p>
        <a
          href={APPLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="press inline-block bg-ink text-paper px-9 py-3.5 text-[15px] font-medium mt-10"
        >
          Membership form
        </a>
      </div>
      <div class="relative overflow-hidden aspect-[4/3]">
        <img
          src="/images/domains/space-3.jpg"
          alt="Falcon Heavy launch"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <ConsoleFooter />
</BaseLayout>
