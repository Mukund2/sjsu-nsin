---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsoleFooter from "../components/layout/ConsoleFooter.astro";
---

<BaseLayout
  title="Not found — SJSU NSIN"
  description="This page doesn't exist."
  theme="console"
>
  <section class="min-h-screen flex items-center pt-24">
    <div class="max-w-[1500px] mx-auto w-full px-5 sm:px-10">
      <h1 class="t-display text-paper max-w-[14ch]">This page doesn&rsquo;t exist.</h1>
      <p class="t-lede text-paper/70 mt-6 max-w-[44ch]">
        Wherever this link was supposed to go, it isn&rsquo;t here anymore.
      </p>
      <a
        href="/"
        class="press inline-block bg-paper text-ink px-9 py-3.5 text-[15px] font-medium mt-12"
      >
        Back to the homepage
      </a>
    </div>
  </section>

  <ConsoleFooter />
</BaseLayout>
