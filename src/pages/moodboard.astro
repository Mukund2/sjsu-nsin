---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Three worlds — NSIN identity moodboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Young+Serif&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Spectral:ital,wght@0,300;0,400;0,600;1,300;1,400&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ── the thesis ── -->
    <header class="thesis">
      <p class="thesis-kicker">NSIN at San José State — identity moodboard, round one</p>
      <h1>A quiet summer is the product of deterrence.</h1>
      <p class="thesis-body">
        Europe's coastline is its playground and its most defended ground at
        once. The leisure isn't irony and it isn't decoration — it's the
        argument: this is what the work protects. Three ways to build a world
        out of that idea, below. React to feelings, not layouts — everything
        here is disposable.
      </p>
    </header>

    {worlds.map((w) => (
      <section class={`world world-${w.id}`} id={w.id}>
        <div class="world-head">
          <p class="world-index">{w.index}</p>
          <h2 class={`world-name font-${w.font}`}>{w.name}</h2>
          <p class="world-thesis">{w.thesis}</p>
        </div>

        {w.images.length > 0 ? (
          <div class="collage">
            {w.images.map((img) => (
              <figure class={img.tall ? "tall" : ""}>
                <img src={img.src} alt={img.alt} loading="lazy" />
                {img.note && <figcaption class="scribble">{img.note}</figcaption>}
              </figure>
            ))}
          </div>
        ) : (
          <p class="pending">[ image set loading — see below ]</p>
        )}

        <div class="world-meta">
          <div class="chips">
            {w.palette.map((c) => (
              <div class="chip">
                <span class="swatch" style={`background:${c.hex}`}></span>
                <span class="chip-label">{c.name}<br />{c.hex}</span>
              </div>
            ))}
          </div>
          <div class="specimen">
            <p class={`specimen-line font-${w.font}`}>{w.specimen}</p>
            <p class="specimen-caption">{w.caption}</p>
          </div>
          <p class="serious"><strong>Where the seriousness lives:</strong> {w.serious}</p>
        </div>
      </section>
    ))}

    <footer class="board-foot">
      <p>
        Pick one. Or mix two. Or tell me which single image above feels most
        like the club — that answer is worth more than any label.
      </p>
    </footer>

    <style>
      * {
        margin: 0;
        box-sizing: border-box;
      }
      body {
        background: #f1efe9;
        color: #161616;
        font-family: "Newsreader", Georgia, serif;
        font-size: 1.125rem;
        line-height: 1.5;
      }

      /* world-specific display faces */
      .font-a {
        font-family: "Archivo", sans-serif;
        font-variation-settings: "wdth" 118;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .font-b {
        font-family: "Young Serif", Georgia, serif;
        font-weight: 400;
      }
      .font-c {
        font-family: "Spectral", Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .thesis {
        padding: clamp(3.5rem, 9vw, 7rem) clamp(1.5rem, 6vw, 5rem) clamp(2.5rem, 6vw, 4.5rem);
        max-width: 72rem;
      }
      .thesis-kicker {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6b6357;
      }
      .thesis h1 {
        font-family: "Newsreader", serif;
        font-optical-sizing: auto;
        font-size: clamp(2.6rem, 1.2rem + 6vw, 6rem);
        font-weight: 300;
        line-height: 1.02;
        letter-spacing: -0.02em;
        margin: 1.4rem 0 1.6rem;
        max-width: 18ch;
        text-wrap: balance;
      }
      .thesis-body {
        max-width: 46rem;
        font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
        color: #3c372f;
        text-wrap: pretty;
      }

      .world {
        padding: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 6vw, 5rem);
        border-top: 1.5px solid #16161622;
      }
      .world-head {
        max-width: 72rem;
        margin-bottom: 2.4rem;
      }
      .world-index {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
        color: #6b6357;
      }
      .world-name {
        font-size: clamp(2.4rem, 1.4rem + 4.5vw, 5rem);
        line-height: 1;
        margin: 0.5rem 0 1rem;
      }
      .world-thesis {
        max-width: 44rem;
        font-size: 1.2rem;
        color: #3c372f;
        text-wrap: pretty;
      }

      /* collage — overlapping, slightly askew, annotated */
      .collage {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        grid-auto-rows: 11rem;
        gap: 1.1rem;
        max-width: 90rem;
      }
      .collage figure {
        position: relative;
        overflow: visible;
        grid-row: span 2;
      }
      .collage figure.tall {
        grid-row: span 3;
      }
      .collage img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        box-shadow: 0 14px 30px -18px rgb(22 22 22 / 0.45);
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .collage figure:nth-child(3n) img {
        transform: rotate(0.7deg);
      }
      .collage figure:nth-child(3n + 1) img {
        transform: rotate(-0.6deg);
      }
      .collage figure:hover img {
        transform: rotate(0deg) scale(1.025);
      }
      .scribble {
        position: absolute;
        bottom: -0.4rem;
        left: 0.6rem;
        transform: rotate(-2deg);
        font-family: "Caveat", cursive;
        font-size: 1.35rem;
        color: #161616;
        background: #f1efe9;
        padding: 0 0.5rem;
        box-shadow: 0 2px 10px -4px rgb(22 22 22 / 0.35);
      }

      .pending {
        font-family: "IBM Plex Mono", monospace;
        color: #6b6357;
        padding: 2rem 0;
      }

      .world-meta {
        max-width: 72rem;
        margin-top: 2.6rem;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 2.5rem;
        align-items: start;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
      }
      .chip {
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }
      .swatch {
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        border: 1.5px solid #16161633;
        display: inline-block;
      }
      .chip-label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        line-height: 1.35;
        color: #4a453c;
        text-transform: uppercase;
      }
      .specimen-line {
        font-size: clamp(1.7rem, 1.2rem + 2vw, 2.7rem);
        line-height: 1.08;
        text-wrap: balance;
      }
      .specimen-caption {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8125rem;
        color: #6b6357;
        margin-top: 0.7rem;
      }
      .serious {
        grid-column: 1 / -1;
        max-width: 56rem;
        color: #3c372f;
        border-top: 1.5px solid #16161622;
        padding-top: 1.1rem;
      }

      .board-foot {
        border-top: 1.5px solid #16161622;
        padding: 2.5rem clamp(1.5rem, 6vw, 5rem) 4rem;
      }
      .board-foot p {
        font-family: "Caveat", cursive;
        font-size: 1.6rem;
        max-width: 34rem;
        transform: rotate(-0.5deg);
      }

      @media (max-width: 760px) {
        .world-meta {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
