---
const year = new Date().getFullYear();
---

<footer class="border-t border-paper/10 bg-ink">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <img src="/logo.svg" alt="SJSU NSIN" class="h-8 w-auto invert brightness-200 mb-5" />
        <p class="text-sm text-paper/45 leading-relaxed max-w-sm">
          The National Security Innovation Network at San Jos&eacute; State University.
          Connecting Silicon Valley's next generation of engineers, designers, and
          strategists with the missions that need them most.
        </p>
      </div>

      <div>
        <h4 class="text-sm text-paper/70 mb-5">Navigate</h4>
        <div class="flex flex-col gap-2.5">
          <a href="/about" class="text-sm text-paper/45 hover:text-paper transition-colors">About</a>
          <a href="/contact" class="text-sm text-paper/45 hover:text-paper transition-colors">Contact</a>
          <a href="https://forms.gle/9MLweCMRaaTkrEkGA" target="_blank" rel="noopener noreferrer" class="text-sm text-paper/45 hover:text-paper transition-colors">Apply</a>
        </div>
      </div>

      <div>
        <h4 class="text-sm text-paper/70 mb-5">Connect</h4>
        <div class="flex flex-col gap-2.5">
          <a href="https://www.instagram.com/sjsu_nsin" target="_blank" rel="noopener noreferrer" class="text-sm text-paper/45 hover:text-paper transition-colors">Instagram</a>
          <a href="https://www.linkedin.com/company/sjsu-nsin" target="_blank" rel="noopener noreferrer" class="text-sm text-paper/45 hover:text-paper transition-colors">LinkedIn</a>
        </div>
      </div>
    </div>

    <div class="border-t border-paper/10 mt-14 pt-8">
      <p class="text-[13px] text-paper/35">
        &copy; {year} National Security Innovation Network at San Jos&eacute; State University
      </p>
    </div>
  </div>
</footer>
