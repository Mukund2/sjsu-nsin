---
const year = new Date().getFullYear();

const links = [
  { label: "About", href: "/about", external: false },
  { label: "Contact", href: "/contact", external: false },
  { label: "Apply", href: "https://forms.gle/9MLweCMRaaTkrEkGA", external: true },
  { label: "Instagram", href: "https://www.instagram.com/sjsu_nsin", external: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/sjsu-nsin", external: true },
];
---

<footer class="border-t border-paper/10 bg-ink">
  <div class="max-w-[1500px] mx-auto px-5 sm:px-10 pt-20 pb-10">
    <p class="t-h2 text-paper max-w-[18ch]">
      National Security Innovation Network at San Jos&eacute; State.
    </p>
    <div class="mt-16 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-6">
      <nav class="flex flex-wrap gap-x-7 gap-y-2">
        {links.map(l => (
          <a
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener noreferrer" : undefined}
            class="link t-caption text-paper/55 hover:text-paper"
          >
            {l.label}
          </a>
        ))}
      </nav>
      <p class="t-caption text-paper/35">&copy; {year}</p>
    </div>
  </div>
</footer>
