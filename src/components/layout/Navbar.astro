---
interface Props {
  theme?: "light" | "console";
}

const { theme = "light" } = Astro.props;
const isConsole = theme === "console";

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const applyHref = "https://forms.gle/9MLweCMRaaTkrEkGA";
const currentPath = Astro.url.pathname;
---

<nav id="main-navbar" class:list={[
  "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
  isConsole ? "navbar-console" : "navbar-scrolled"
]}>
  <div class="max-w-[1500px] mx-auto px-5 sm:px-10 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.svg"
        alt="SJSU NSIN"
        class:list={[
          "h-10 w-auto transition-all duration-300",
          isConsole ? "invert brightness-200" : ""
        ]}
      />
      <span class:list={[
        "text-[14px] font-medium hidden lg:block leading-snug",
        isConsole ? "text-paper" : "text-near-black"
      ]}>
        National Security Innovation Network
        <span class:list={["block text-[13px] font-normal", isConsole ? "text-paper/55" : "text-mid-gray"]}>at San Jos&eacute; State University</span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8 pr-2">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-[14px] transition-colors duration-300",
            isConsole
              ? (currentPath === link.href ? "text-paper font-medium" : "text-paper/60 hover:text-paper")
              : (currentPath === link.href || currentPath === link.href + "/" ? "text-near-black font-medium" : "text-mid-gray hover:text-near-black")
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={applyHref}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "press text-[15px] font-medium px-4 py-2",
          isConsole
            ? "bg-paper text-ink hover:bg-paper-dim"
            : "bg-near-black text-white hover:bg-dark-gray"
        ]}
      >
        Apply
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class:list={[
        "md:hidden p-2 transition-colors duration-300",
        isConsole ? "text-paper" : "text-near-black"
      ]}
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class:list={[
    "hidden md:hidden border-t",
    isConsole ? "border-paper/10 bg-ink" : "border-light-gray bg-white"
  ]}>
    <div class="px-6 py-5 flex flex-col gap-4">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-[14px] transition-colors",
            isConsole ? "text-paper/70 hover:text-paper" : "text-dark-gray hover:text-near-black"
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={applyHref}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "press text-[15px] font-medium px-4 py-2.5 text-center",
          isConsole ? "bg-paper text-ink" : "bg-near-black text-white"
        ]}
      >
        Apply
      </a>
    </div>
  </div>
</nav>

{!isConsole && <div class="h-16"></div>}

<style>
  .navbar-scrolled {
    background-color: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-light-gray, #e5e5e5);
  }
  .navbar-console {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  .navbar-console.is-scrolled {
    background-color: rgb(35 32 32 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(242 237 227 / 0.08);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  const navbar = document.getElementById('main-navbar');
  if (navbar?.classList.contains('navbar-console')) {
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      navbar.classList.toggle('is-scrolled', y > 8);
      // hide while reading downward, return on upward intent
      if (y > 240 && y > lastY + 4) {
        navbar.classList.add('nav-hidden');
      } else if (y < lastY - 4 || y <= 240) {
        navbar.classList.remove('nav-hidden');
      }
      lastY = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
