---
import { domains } from "../../data/domains";

interface Props {
  theme?: "light" | "console";
}

const { theme = "light" } = Astro.props;
const isConsole = theme === "console";

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const applyHref = "https://forms.gle/9MLweCMRaaTkrEkGA";
const currentPath = Astro.url.pathname;
---

<nav id="main-navbar" class:list={[
  "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
  isConsole ? "navbar-console" : "navbar-scrolled"
]}>
  <div class="w-full px-4 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.svg"
        alt="SJSU NSIN"
        class:list={[
          "h-10 w-auto transition-all duration-300",
          isConsole ? "invert brightness-200" : ""
        ]}
      />
      <span class:list={[
        "text-[12px] uppercase tracking-[0.12em] font-medium hidden lg:block leading-tight",
        isConsole ? "text-white" : "text-near-black"
      ]}>
        National Security Innovation Network<br />
        <span class:list={[isConsole ? "text-white/50" : "text-mid-gray"]}>at San Jos&eacute; State University</span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-7 pr-2">
      {isConsole && (
        <div class="flex items-center gap-5 border-r border-white/15 pr-7">
          {domains.map(d => {
            const href = `/domains/${d.slug}`;
            const active = currentPath === href || currentPath === href + "/";
            return (
              <a
                href={href}
                class:list={[
                  "decal transition-colors duration-200 flex items-center gap-1.5",
                  active ? "text-white" : "text-white/50 hover:text-white"
                ]}
              >
                <span
                  class="inline-block w-1.5 h-1.5 rounded-full"
                  style={`background-color: ${active ? d.accent : "rgba(255,255,255,0.25)"}`}
                ></span>
                {d.name}
              </a>
            );
          })}
        </div>
      )}
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-[13px] uppercase tracking-[0.15em] transition-colors duration-300",
            isConsole
              ? (currentPath === link.href ? "text-white font-medium" : "text-white/60 hover:text-white")
              : (currentPath === link.href || currentPath === link.href + "/" ? "text-near-black font-medium" : "text-mid-gray hover:text-near-black")
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={applyHref}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "text-[12px] uppercase tracking-[0.15em] font-medium px-4 py-2 transition-colors duration-200",
          isConsole
            ? "bg-white text-near-black hover:bg-light-gray"
            : "bg-near-black text-white hover:bg-dark-gray"
        ]}
      >
        Apply &mdash; Cohort 01
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class:list={[
        "md:hidden p-2 transition-colors duration-300",
        isConsole ? "text-white" : "text-near-black"
      ]}
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class:list={[
    "hidden md:hidden border-t",
    isConsole ? "border-white/10 bg-near-black" : "border-light-gray bg-white"
  ]}>
    <div class="px-6 py-5 flex flex-col gap-4">
      {isConsole && domains.map(d => (
        <a
          href={`/domains/${d.slug}`}
          class="decal text-white/70 hover:text-white transition-colors flex items-center gap-2"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full" style={`background-color: ${d.accent}`}></span>
          {d.designator} &mdash; {d.name}
        </a>
      ))}
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-[13px] uppercase tracking-[0.15em] transition-colors",
            isConsole ? "text-white/70 hover:text-white" : "text-dark-gray hover:text-near-black"
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={applyHref}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "text-[12px] uppercase tracking-[0.15em] font-medium px-4 py-2.5 text-center",
          isConsole ? "bg-white text-near-black" : "bg-near-black text-white"
        ]}
      >
        Apply &mdash; Cohort 01
      </a>
    </div>
  </div>
</nav>

{!isConsole && <div class="h-14"></div>}

<style>
  .navbar-scrolled {
    background-color: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-light-gray, #e5e5e5);
  }
  .navbar-console {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  .navbar-console.is-scrolled {
    background-color: rgb(10 10 10 / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  const navbar = document.getElementById('main-navbar');
  if (navbar?.classList.contains('navbar-console')) {
    const onScroll = () => {
      navbar.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
