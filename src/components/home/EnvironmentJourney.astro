---
// EnvironmentJourney — Act I of the journey as ONE continuous filmed shot.
// Two stacked full-bleed AI-rendered clips inside the pin: orbit.mp4 (the
// SPACE beat, Earth limb from station altitude) crossfading into clouds.mp4
// (the AIR beat, golden cloud-deck flight) around mid-scrub — then the paper
// flash marks the cloud-breakthrough touchdown and hands off to the ground
// sections ("Lockheed was here before Google." lands right after). The sea
// beat resumes in SeaJourney further down the page. Videos self-play (muted
// autoplay loops — no RAF here); a ScrollTrigger gate pauses them offscreen.
// Keeps section id="altitude" and pin id="alt-pin" (Protagonist targets
// them). Reduced-motion / no-JS: videos still render as ambient loops; the
// captions stack as plain sections (alt-pin/.alt-cap rules in global.css).
import { domains } from "../../data/domains";

const bySlug = Object.fromEntries(domains.map((d) => [d.slug, d]));

const caps = [
  { name: bySlug.space.name, tagline: bySlug.space.tagline, slug: "space" },
  { name: bySlug.air.name, tagline: bySlug.air.tagline, slug: "air" },
];
---

<section id="altitude" class="scheme-ink relative">
  <div id="alt-pin" class="relative h-screen overflow-hidden">
    <!-- layer A — SPACE: visible from scrub 0 -->
    <video
      id="ej-video-space"
      class="absolute inset-0 w-full h-full object-cover"
      src="/videos/orbit.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
    <!-- layer B — AIR: crossfades in over the space→air handoff -->
    <video
      id="ej-video-air"
      class="absolute inset-0 w-full h-full object-cover"
      src="/videos/clouds.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      style="opacity: 0;"
    ></video>

    <div id="ej-scrim" class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-ink/25 pointer-events-none"></div>

    {caps.map((c, i) => (
      <div class="alt-cap absolute inset-x-0 bottom-0" style={i === 0 ? "" : "opacity: 0; visibility: hidden;"}>
        <div class="max-w-[1500px] mx-auto px-5 sm:px-10 pb-16 sm:pb-20">
          <h3 class="t-h1 text-paper">{c.name}</h3>
          <p class="t-lede mt-4 text-paper/75 max-w-[38ch]">{c.tagline}</p>
          {c.slug && (
            <a
              href={`/domains/${c.slug}`}
              class="press arrow-link mt-7 inline-block w-fit bg-paper text-ink px-7 py-3.5 text-[15px] font-medium"
            >
              Explore {c.name} <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          )}
        </div>
      </div>
    ))}

    <!-- the altimeter: a live instrument, not decoration -->
    <div id="ej-hud" class="absolute right-6 sm:right-10 top-1/2 -translate-y-1/2 h-[58vh] hidden sm:flex items-stretch gap-5 pointer-events-none">
      <div class="flex flex-col justify-between items-end text-right">
        <p id="alt-readout" class="t-h3 text-paper" style="font-variant-numeric: tabular-nums;">408 km</p>
        <p class="t-caption text-paper/45">altitude</p>
      </div>
      <div class="relative w-px bg-paper/25">
        <div
          id="alt-marker"
          class="absolute right-0 w-5 h-px"
          style="background-color: var(--color-gold); top: 0%;"
        ></div>
      </div>
    </div>

    <!-- paper flash at the cloud-breakthrough touchdown; the next section is
         paper, so the unpin cuts straight onto the touchdown statement -->
    <div
      id="ej-flash"
      class="absolute inset-0 pointer-events-none"
      style="background: var(--color-paper); opacity: 0;"
    ></div>
  </div>
</section>

<style is:global>
  /* no-JS / reduced-motion: instruments hide; the videos stay as ambient
     backdrops and the two captions read as stacked sections (alt-pin/.alt-cap
     rules in global.css) */
  html:not(.has-motion) #ej-scrim,
  html:not(.has-motion) #ej-hud,
  html:not(.has-motion) #ej-flash {
    display: none;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function init() {
    const spaceVideo = document.getElementById("ej-video-space") as HTMLVideoElement | null;
    const airVideo = document.getElementById("ej-video-air") as HTMLVideoElement | null;
    if (!spaceVideo || !airVideo) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return; // muted autoplay loops are fine; captions stack via CSS

    gsap.registerPlugin(ScrollTrigger);

    // ── playback gate: clips run only while the section is near the
    // viewport. 1vh approach + 3vh pin (+=300%) + 1vh exit. Function-based
    // because "bottom top" would be measured before the pin spacer exists.
    const videos = [spaceVideo, airVideo];
    ScrollTrigger.create({
      trigger: "#altitude",
      start: "top bottom",
      end: () => "+=" + window.innerHeight * 5,
      onToggle: (self) => {
        for (const v of videos) {
          if (self.isActive) v.play().catch(() => {});
          else v.pause();
        }
      },
    });

    // ── altimeter: 408 km → 0 m over the descent (first 90% of the scrub,
    // matching the old camera travel), no negatives. Two-stage mapping kept
    // from the three.js column: 408→100 km fast, 100 km→0 m on approach.
    const readout = document.getElementById("alt-readout");
    const marker = document.getElementById("alt-marker");
    const fmt = (m: number) => {
      if (m >= 20000) return `${Math.round(m / 1000)} km`;
      const v = Math.max(Math.round(m / 10) * 10, 0);
      return `${v.toLocaleString("en-US")} m`;
    };
    const altitudeAt = (f: number) =>
      f <= 0.5
        ? 408000 - (f / 0.5) * 308000
        : Math.max((1 - (f - 0.5) / 0.5) * 100000, 0);
    let lastReadout = "";
    const descent = { f: 0 }; // 0 = orbit, 1 = touchdown

    // ── the journey (ONE scrubbed timeline, total duration 1) ──────
    const altCaps = gsap.utils.toArray<HTMLElement>(".alt-cap");
    gsap.set(altCaps, { autoAlpha: 0 });
    gsap.set(altCaps[0], { autoAlpha: 1 });

    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: "#alt-pin",
        start: "top top",
        end: "+=300%",
        pin: true,
        scrub: 0.5,
        anticipatePin: 1,
      },
    });

    // the descent drives the instrument; DESCENT=0.9 as before — the flash
    // owns the last 10%
    tl.to(descent, {
      f: 1,
      duration: 0.9,
      onUpdate: () => {
        if (!readout || !marker) return;
        marker.style.top = `${descent.f * 100}%`;
        const text = fmt(altitudeAt(descent.f));
        if (text !== lastReadout) {
          readout.textContent = text;
          lastReadout = text;
        }
      },
    }, 0);

    // the space→air handoff: clouds crossfade over the orbit clip at 0.45–0.55
    tl.fromTo("#ej-video-air", { opacity: 0 }, { opacity: 1, duration: 0.1 }, 0.45);

    // caption windows — same scrub positions as the three.js cut:
    // space out at ~0.50 (just as the crossfade starts), air in at 0.54
    // (as the clouds take over), air clear at ~0.85 before the flash
    const windows: [number, number][] = [
      [0, 0.504],     // space
      [0.54, 0.846],  // air
    ];
    altCaps.forEach((capEl, i) => {
      const [tin, tout] = windows[i];
      if (i > 0) {
        tl.fromTo(capEl, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.03 }, tin);
      }
      tl.to(capEl, { autoAlpha: 0, y: -20, duration: 0.025 }, tout);
    });

    // the touchdown: paper floods the frame and holds through the unpin —
    // the next section is paper, so the cut lands on the headline
    tl.to("#ej-flash", { opacity: 1, duration: 0.08 }, 0.88);
    tl.to({}, { duration: 0.04 }, 0.96); // hold white to the end
  }

  init();
</script>
